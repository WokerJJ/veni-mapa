{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "initial-version": "0.1.0",
  "pull-request-title-pattern": "chore(release): publicar ${version}",
  "pull-request-header": "Release preparada por release-please. Al fusionar este PR se crea el tag, la release y el workflow de release le adjunta el mapa.",
  "changelog-sections": [
    { "type": "feat", "section": "Funcionalidades" },
    { "type": "fix", "section": "Correcciones" },
    { "type": "perf", "section": "Rendimiento" },
    { "type": "docs", "section": "Documentación" },
    { "type": "ci", "section": "Integración continua" },
    { "type": "deps", "section": "Dependencias" },
    { "type": "chore", "section": "Mantenimiento", "hidden": true },
    { "type": "refactor", "section": "Refactorización", "hidden": true },
    { "type": "test", "section": "Pruebas", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "veni-mapa"
    }
  }
}
